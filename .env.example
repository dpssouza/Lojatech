# Credenciais administrativas do PostgreSQL (somente para administração/initialização)
DB_NAME=lojatech
DB_ADMIN_USER=lojatech
DB_ADMIN_PASSWORD=SUBSTITUA_POR_UM_SEGREDO_ADMIN_FORTE

# Credenciais restritas usadas pela aplicação Node.js
DB_USER=lojatech_app
DB_PASSWORD=SUBSTITUA_POR_OUTRO_SEGREDO_FORTE_E_UNICO
DB_POOL_MAX=10
# Publicação da aplicação
APP_BIND_IP=127.0.0.1
APP_HOST_PORT=3000

# Acesso ao painel administrativo
ADMIN_USERNAME=defina_um_usuario
ADMIN_PASSWORD=substitua_por_uma_senha_forte
ADMIN_SESSION_SECRET=substitua_por_uma_chave_aleatoria_de_64_caracteres_ou_mais